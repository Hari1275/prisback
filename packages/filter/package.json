{
  "name": "@prisback/filter",
  "description": "Utility typings and filters for PrisBack filters.",
  "version": "7.0.2",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "PrisBack Contributors (based on IBM Corp. and LoopBack contributors)",
  "copyright.owner": "PrisBack Contributors; IBM Corp. and LoopBack contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hari1275/prisback.git",
    "directory": "packages/filter"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "build": "pb-tsc",
    "build:watch": "pb-tsc --watch",
    "pretest": "npm run clean && npm run build",
    "test": "pb-mocha \"dist/__tests__/**/*.js\"",
    "clean": "pb-clean dist *.tsbuildinfo .eslintcache"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "dependencies": {
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@prisback/build": "workspace:*",
    "@prisback/testlab": "workspace:*",
    "@types/node": "^20.19.43",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  }
}
