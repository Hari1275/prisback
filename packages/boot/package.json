{
  "name": "@prisback/boot",
  "description": "A collection of Booters for PrisBack Applications",
  "version": "1.0.0",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "PrisBack Contributors (based on IBM Corp. and LoopBack contributors)",
  "copyright.owner": "PrisBack Contributors; IBM Corp. and LoopBack contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hari1275/prisback.git",
    "directory": "packages/boot"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "acceptance": "pb-mocha \"dist/__tests__/acceptance/**/*.js\"",
    "build": "pb-tsc",
    "clean": "pb-clean loopback-boot*.tgz dist *.tsbuildinfo package",
    "pretest": "npm run build",
    "integration": "pb-mocha \"dist/__tests__/integration/**/*.js\"",
    "test": "pb-mocha \"dist/__tests__/**/*.js\"",
    "unit": "pb-mocha \"dist/__tests__/unit/**/*.js\"",
    "verify": "npm pack && tar xf loopback-boot*.tgz && tree package && npm run clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "peerDependencies": {
    "@prisback/core": "workspace:*"
  },
  "dependencies": {
    "@prisback/model-api-builder": "workspace:*",
    "@prisback/repository": "workspace:*",
    "@prisback/service-proxy": "workspace:*",
    "@types/debug": "^4.1.13",
    "debug": "^4.4.3",
    "glob": "^13.0.6",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@prisback/build": "workspace:*",
    "@prisback/core": "workspace:*",
    "@prisback/eslint-config": "workspace:*",
    "@prisback/rest": "workspace:*",
    "@prisback/testlab": "workspace:*",
    "@types/node": "^20.19.43"
  }
}
