{
  "name": "@prisback/testlab",
  "description": "A collection of test utilities we use to write LoopBack tests.",
  "version": "9.0.1",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "PrisBack Contributors (based on IBM Corp. and LoopBack contributors)",
  "copyright.owner": "PrisBack Contributors; IBM Corp. and LoopBack contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hari1275/prisback.git",
    "directory": "packages/testlab"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "build": "pb-tsc",
    "clean": "pb-clean loopback-testlab*.tgz dist *.tsbuildinfo package",
    "pretest": "npm run build",
    "test": "pb-mocha \"dist/__tests__/**/*.js\"",
    "verify": "npm pack && tar xf loopback-testlab*.tgz && tree package && npm run clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "fixtures",
    "src",
    "!*/__tests__"
  ],
  "dependencies": {
    "@hapi/shot": "^6.0.3",
    "@types/express": "^4.17.25",
    "@types/fs-extra": "^11.0.4",
    "@types/shot": "^4.0.5",
    "@types/sinon": "^22.0.2",
    "@types/supertest": "^2.0.16",
    "express": "^4.22.3",
    "fs-extra": "^11.4.1",
    "oas-validator": "^5.0.8",
    "should": "^13.2.3",
    "sinon": "^22.1.0",
    "supertest": "^7.2.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@prisback/build": "workspace:*",
    "@prisback/eslint-config": "workspace:*",
    "@types/node": "^20.19.43"
  }
}
