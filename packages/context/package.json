{
  "name": "@prisback/context",
  "description": "Facilities to manage artifacts and their dependencies in your Node.js applications. The module exposes TypeScript/JavaScript APIs and decorators to register artifacts, declare dependencies, and resolve artifacts by keys. It also serves as an IoC container to support dependency injection",
  "version": "9.0.2",
  "keywords": [
    "PrisBack",
    "IoC",
    "Inversion",
    "Control",
    "Container",
    "Decorators",
    "Context"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "PrisBack Contributors (based on IBM Corp. and LoopBack contributors)",
  "copyright.owner": "PrisBack Contributors; IBM Corp. and LoopBack contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hari1275/prisback.git",
    "directory": "packages/context"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "acceptance": "pb-mocha \"dist/__tests__/acceptance/**/*.js\"",
    "build": "pb-tsc",
    "clean": "pb-clean loopback-context*.tgz dist *.tsbuildinfo package",
    "pretest": "npm run build",
    "test": "pb-mocha \"dist/__tests__/**/*.js\"",
    "unit": "pb-mocha \"dist/__tests__/unit/**/*.js\"",
    "verify": "npm pack && tar xf loopback-context*.tgz && tree package && npm run clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "dependencies": {
    "@prisback/metadata": "workspace:*",
    "@types/debug": "^4.1.13",
    "debug": "^4.4.3",
    "hyperid": "^3.3.0",
    "p-event": "^4.2.0",
    "tslib": "^2.9.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@prisback/build": "workspace:*",
    "@prisback/eslint-config": "workspace:*",
    "@prisback/testlab": "workspace:*",
    "@types/bluebird": "^3.5.42",
    "@types/node": "^20.19.43",
    "@types/uuid": "^11.0.0",
    "bluebird": "^3.7.2"
  }
}
