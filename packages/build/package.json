{
  "name": "@prisback/build",
  "description": "A set of common scripts and default configurations to build PrisBack or other TypeScript modules",
  "version": "13.0.2",
  "license": "MIT",
  "bin": {
    "pb-tsc": "./bin/compile-package.js",
    "pb-ttsc": "./bin/compile-package.js",
    "pb-eslint": "./bin/run-eslint.js",
    "pb-prettier": "./bin/run-prettier.js",
    "pb-mocha": "./bin/run-mocha.js",
    "pb-nyc": "./bin/run-nyc.js",
    "pb-clean": "./bin/run-clean.js"
  },
  "main": "index.js",
  "author": "PrisBack Contributors (based on IBM Corp. and LoopBack contributors)",
  "copyright.owner": "PrisBack Contributors; IBM Corp. and LoopBack contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hari1275/prisback.git",
    "directory": "packages/build"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "test": "npm run mocha",
    "mocha": "node bin/run-mocha --timeout 30000 \"test/integration/*.js\" \"test/unit/*.js\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@prisback/eslint-config": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@typescript/native": "npm:typescript@~7.0.2",
    "cross-spawn": "^7.0.6",
    "debug": "^4.4.3",
    "eslint": "^8.57.1",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "lodash": "^4.18.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^5.0.10",
    "source-map-support": "^0.5.21",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  }
}
