{
  "name": "@prisback/rest",
  "description": "Expose controllers as REST endpoints and route REST API requests to controller methods",
  "version": "16.0.1",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "PrisBack Contributors (based on IBM Corp. and LoopBack contributors)",
  "copyright.owner": "PrisBack Contributors; IBM Corp. and LoopBack contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hari1275/prisback.git",
    "directory": "packages/rest"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "acceptance": "pb-mocha \"dist/__tests__/acceptance/**/*.js\"",
    "build": "pb-tsc",
    "clean": "pb-clean loopback-rest*.tgz dist *.tsbuildinfo package",
    "pretest": "npm run build",
    "integration": "pb-mocha \"dist/__tests__/integration/**/*.js\"",
    "test": "pb-mocha \"dist/__tests__/**/*.js\"",
    "unit": "pb-mocha \"dist/__tests__/unit/**/*.js\"",
    "verify": "npm pack && tar xf loopback-rest*.tgz && tree package && npm run clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "peerDependencies": {
    "@prisback/core": "workspace:*"
  },
  "dependencies": {
    "@openapi-contrib/openapi-schema-to-json-schema": "^5.1.1",
    "@prisback/express": "workspace:*",
    "@prisback/http-server": "workspace:*",
    "@prisback/openapi-v3": "workspace:*",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/http-errors": "^2.0.5",
    "@types/on-finished": "^2.3.5",
    "@types/serve-static": "2.2.0",
    "@types/type-is": "^1.6.7",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "body-parser": "^2.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "express": "^4.22.3",
    "http-errors": "^2.0.1",
    "js-yaml": "^4.3.2",
    "json-schema-compare": "^0.2.2",
    "lodash": "^4.18.1",
    "on-finished": "^2.4.1",
    "path-to-regexp": "^6.3.0",
    "qs": "^6.17.1",
    "strong-error-handler": "^6.0.3",
    "tslib": "^2.9.1",
    "type-is": "^2.1.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@prisback/build": "workspace:*",
    "@prisback/core": "workspace:*",
    "@prisback/eslint-config": "workspace:*",
    "@prisback/openapi-spec-builder": "workspace:*",
    "@prisback/repository": "workspace:*",
    "@prisback/testlab": "workspace:*",
    "@types/debug": "^4.1.13",
    "@types/js-yaml": "^4.0.9",
    "@types/json-schema-compare": "^0.2.4",
    "@types/lodash": "^4.17.27",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/on-finished": "^2.3.5",
    "@types/qs": "^6.15.1",
    "multer": "^2.5.0"
  }
}
