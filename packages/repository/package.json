{
  "name": "@prisback/repository",
  "description": "Define and implement a common set of interfaces for interacting with databases",
  "version": "9.0.1",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "PrisBack Contributors (based on IBM Corp. and LoopBack contributors)",
  "copyright.owner": "PrisBack Contributors; IBM Corp. and LoopBack contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/prisback/prisback.git",
    "directory": "packages/repository"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "acceptance": "pb-mocha \"dist/__tests__/acceptance/**/*.js\"",
    "build": "pb-tsc",
    "clean": "pb-clean loopback-repository*.tgz dist *.tsbuildinfo package",
    "pretest": "npm run build",
    "test": "pb-mocha \"dist/__tests__/**/*.js\"",
    "verify": "npm pack && tar xf loopback-repository*.tgz && tree package && npm run clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "peerDependencies": {
    "@prisback/core": "workspace:*"
  },
  "dependencies": {
    "@prisback/filter": "workspace:*",
    "@types/debug": "^4.1.13",
    "debug": "^4.4.3",
    "lodash": "^4.18.1",
    "loopback-datasource-juggler": "^7.0.4",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@prisback/build": "workspace:*",
    "@prisback/core": "workspace:*",
    "@prisback/eslint-config": "workspace:*",
    "@prisback/testlab": "workspace:*",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.27",
    "@types/node": "^20.19.43",
    "bson": "7.3.4"
  }
}
