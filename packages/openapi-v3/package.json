{
  "name": "@prisback/openapi-v3",
  "description": "Decorators that annotate LoopBack artifacts with OpenAPI v3 metadata and utilities that transform LoopBack metadata to OpenAPI v3 specifications",
  "version": "12.0.1",
  "keywords": [
    "Swagger",
    "OpenAPI Spec",
    "TypeScript"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "PrisBack Contributors (based on IBM Corp. and LoopBack contributors)",
  "copyright.owner": "PrisBack Contributors; IBM Corp. and LoopBack contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/prisback/prisback.git",
    "directory": "packages/openapi-v3"
  },
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "build": "pb-tsc",
    "clean": "pb-clean loopback-openapi-v3*.tgz dist *.tsbuildinfo package",
    "integration": "pb-mocha \"dist/__tests__/integration/**/*.js\"",
    "pretest": "npm run build",
    "test": "pb-mocha \"dist/__tests__/**/*.js\"",
    "unit": "pb-mocha \"dist/__tests__/unit/**/*.js\"",
    "verify": "npm pack && tar xf loopback-openapi-v3*.tgz && tree package && npm run clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "src",
    "!*/__tests__"
  ],
  "peerDependencies": {
    "@prisback/core": "workspace:*"
  },
  "dependencies": {
    "@prisback/repository-json-schema": "workspace:*",
    "debug": "^4.4.3",
    "http-status": "^1.8.1",
    "json-merge-patch": "^1.0.2",
    "lodash": "^4.18.1",
    "openapi3-ts": "^2.0.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@prisback/build": "workspace:*",
    "@prisback/core": "workspace:*",
    "@prisback/eslint-config": "workspace:*",
    "@prisback/openapi-spec-builder": "workspace:*",
    "@prisback/repository": "workspace:*",
    "@prisback/testlab": "workspace:*",
    "@types/debug": "^4.1.13",
    "@types/json-merge-patch": "1.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^20.19.43"
  }
}
